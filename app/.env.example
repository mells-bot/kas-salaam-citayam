# Lokal (SQLite) — jalan langsung tanpa setup apa pun
DATABASE_URL="file:./dev.db"

# Produksi (Turso / libSQL) — dialek sama, tidak perlu ubah kode
# DATABASE_URL="libsql://nama-db-akun.turso.io"
# TURSO_AUTH_TOKEN="..."

# Wajib diganti di produksi. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter-ya"
