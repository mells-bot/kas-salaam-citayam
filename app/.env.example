# Lokal (SQLite) — jalan langsung tanpa setup apa pun. Selalu diisi format
# "file:...", di semua environment termasuk produksi (nilainya diabaikan saat
# TURSO_DATABASE_URL terisi — lihat komentar di src/lib/db.ts).
DATABASE_URL="file:./dev.db"

# Produksi (Turso / libSQL) — isi HANYA di produksi. Dialek sama dengan
# SQLite, jadi skema dan kode tidak berubah.
# TURSO_DATABASE_URL="libsql://nama-db-akun.turso.io"
# TURSO_AUTH_TOKEN="..."

# Wajib diganti di produksi. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter-ya"
